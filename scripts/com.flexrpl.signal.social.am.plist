<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.flexrpl.signal.social.am</string>

    <!-- Run every day at 7:00 AM local time — post the Watch List card -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/garotconklin/garotm/fleXRPL/signal/.venv/bin/python</string>
        <string>/Users/garotconklin/garotm/fleXRPL/signal/post_scheduled.py</string>
        <string>--slot</string>
        <string>am</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/garotconklin/garotm/fleXRPL/signal</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/garotconklin/garotm/fleXRPL/signal/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>SIGNAL_ENV_FILE</key>
        <string>/Users/garotconklin/garotm/fleXRPL/signal/.env</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/garotconklin/garotm/fleXRPL/signal/logs/social_am.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/garotconklin/garotm/fleXRPL/signal/logs/social_am.log</string>
</dict>
</plist>
