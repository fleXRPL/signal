# Signal — Social posting credentials
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# Bluesky account handle (e.g. signal.bsky.social)
BLUESKY_HANDLE=yourhandle.bsky.social

# App password from Bluesky: Settings → Privacy and Security → App Passwords
# Generate one named "signal-pipeline" — never use your real account password
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
